   "source": [
    "def to_kelvin(TC):\n",
    "\treturn TC + 273.15\n",
    "\n",
    "p1 = 1.00\n",
    "T1 = to_kelvin(22.0)\n",
    "T2 = to_kelvin(32.0)\n",
    "ratio_V = 1.38 \n",
    "\n",
    "p2 = p1 * (1.0 / ratio_V) * (T2 / T1)\n",
    "\n",
    "print(f\"p2 = {p2:.3f} atm = {p2*101.325:.1f} kPa\")"
   ]
  }
